<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.joaomarcosvs</groupId>
        <artifactId>truco</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>truco-web</artifactId>
    <name>Truco :: Web</name>
    <description>Frontend web de teste: uma página para jogar contra o bot ou contra um amigo numa sala, servida por um servidor HTTP só com o JDK.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.joaomarcosvs</groupId>
            <artifactId>truco-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joaomarcosvs</groupId>
            <artifactId>truco-bots</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joaomarcosvs</groupId>
            <artifactId>truco-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joaomarcosvs</groupId>
            <artifactId>truco-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Jar executável, com tudo dentro: java -jar truco-web/target/truco-web.jar -->
                            <outputFile>${project.build.directory}/truco-web.jar</outputFile>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <!-- Só o manifesto deste módulo, que indica a classe principal. -->
                                <filter>
                                    <artifact>io.github.joaomarcosvs:truco-core</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>io.github.joaomarcosvs:truco-bots</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>io.github.joaomarcosvs:truco-cli</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>io.github.joaomarcosvs:truco-protocol</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>tools.jackson.core:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>com.fasterxml.jackson.core:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.joaomarcosvs.truco.web.TrucoWeb</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- As licenças e os avisos dos jars do Jackson ficam juntos, num arquivo só cada. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/LICENSE</resource>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
