<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.joaomarcosvs</groupId>
        <artifactId>truco</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>truco-cli</artifactId>
    <name>Truco :: CLI</name>
    <description>Cliente de console para jogar e testar o core durante o desenvolvimento.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.joaomarcosvs</groupId>
            <artifactId>truco-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joaomarcosvs</groupId>
            <artifactId>truco-bots</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!--
                                Jar executável, com core e bots dentro: java -jar truco-cli/target/truco-cli.jar
                                Fica num arquivo à parte, para não substituir o jar do módulo, que é a entrada do shade.
                            -->
                            <outputFile>${project.build.directory}/truco-cli.jar</outputFile>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <!-- Só o manifesto da CLI, que indica a classe principal. -->
                                <filter>
                                    <artifact>io.github.joaomarcosvs:truco-core</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>io.github.joaomarcosvs:truco-bots</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.joaomarcosvs.truco.cli.TrucoCli</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
